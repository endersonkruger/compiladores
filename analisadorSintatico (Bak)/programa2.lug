main {
  var int x;
  var int limite;
  var bool continua;

  x := 1;
  limite := 2.5E+3;
  continua := true;

  do {
    x := (x * 2);
    continua := ((x < limite) && ehPequeno(x));
  } while ((continua == true));

  inicia();
  print(fatorial(5));
  print(3.14);
  print(1E-2);
}

function bool ehPequeno(int v) {
  return ((v < 1000) || false);
}

function int inicia() {
  print(0);
  return 0;
}

function int fatorial(int k) {
  var int res;
  var int cont_aux;
  res := 1;
  cont_aux := k;
  while ((cont_aux > 1)) do {
    res := (res * cont_aux);
    cont_aux := (cont_aux - 1);
  };
  return res;
}
