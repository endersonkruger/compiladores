main {
  var int n;
  var int i;
  var int total;
  var bool achou;

  n := 10;
  i := 0;
  total := 0;
  achou := false;

  while ((i < n)) do {
    total := (total + maior(i, (n - i)));
    if ((((i * 2) == n) || (i > 7))) {
      achou := true;
      if ((achou && (total > 20))) {
        print(total);
      };
    };
    i := (i + 1);
  };

  mostra(total, achou);
  print(((total / 2) - 1));
}

function int maior(int a, int b) {
  var int r;
  r := a;
  if ((b > a)) {
    r := b;
  };
  return r;
}

function int mostra(int valor, bool flag) {
  print(valor);
  print(flag);
  return 0;
}
